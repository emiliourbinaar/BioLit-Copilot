---
/**
 * ⚠️ THE ANSWER IS RENDERED VERBATIM, and must not be "improved" here (plan §2). Re-rendering it
 * from clusters would be a second implementation of the synthesis template, presented as the
 * pipeline's own output. If the raw MeSH ids look unfriendly, the fix belongs in
 * `synth/template.py`, where it is pinned and regenerates the fixtures.
 */
import {
  citedPaperIds,
  creators,
  deedLabel,
  excerptedPaperIds,
  type FixtureRun,
} from "../lib/fixtures";

interface Props {
  run: FixtureRun;
}

const { run } = Astro.props;
const named = citedPaperIds(run).length;
const quoted = excerptedPaperIds(run).map((id) => ({ id, paper: run.papers[id]! }));
---

<p class="caveat">
  <strong>This is the pipeline's output, unedited.</strong> The deterministic template
  (ADR-0019) heads each cluster with raw MeSH ids; the cluster list above names them. Every
  sentence in quotation marks is <strong>an excerpt from the abstract</strong> of the paper
  stamped above it, copied verbatim: not paraphrased, shortened or joined. The generator refuses
  to publish one that differs from its source by a single character.
</p>

<pre class="answer" tabindex="0" aria-label="Pipeline answer, verbatim">{run.answer}</pre>

<section class="attribution" aria-labelledby="attribution-heading">
  <h3 id="attribution-heading">Attribution for every quoted paper</h3>
  <p class="quiet">
    {
      quoted.length === named
        ? `The answer quotes all ${named} papers it names.`
        : `The answer quotes ${quoted.length} of the ${named} papers it names; the rest print "(no finding sentence extracted)" and are not excerpted.`
    }{" "}
    Each quoted paper is listed below with its creators, its copyright
    notice and its licence. The pipeline does not assemble citations yet (the synthesis stage
    says so in the ledger), so this site supplies them.
  </p>
  <p class="terms">
    Excerpts are reproduced <strong>verbatim and unmodified</strong>, with the rest of each abstract
    omitted, under each paper's own Creative Commons licence, on a non-commercial portfolio site.
    No endorsement by the authors or publishers is implied. The material is provided as is; each
    licence, linked below, sets out its terms and disclaimer of warranties.
  </p>
  <ol class="cites">
    {
      quoted.map(({ id, paper }) => (
        <li>
          <span class="title">{paper.title}</span>
          <span class="creators">{creators(paper.authors)}.</span>
          <span class="quiet">
            {paper.journal}
            {paper.year ? `, ${paper.year}` : ""}.{" "}
            {paper.copyright ?? "No copyright notice supplied with the article."}
          </span>
          <span class="terms-line">
            Excerpt from the abstract, verbatim and unmodified. Licensed under{" "}
            <a class="licence" href={paper.license_url!} rel="license">
              {deedLabel(paper.license_url!)}
            </a>
            .
          </span>
          <span class="source">
            Source:{" "}
            {paper.doi && <a href={`https://doi.org/${paper.doi}`}>doi:{paper.doi}</a>}
            {paper.pmid && (
              <>
                {paper.doi && " · "}
                <a class="pmid" href={`https://pubmed.ncbi.nlm.nih.gov/${paper.pmid}/`}>
                  PMID {paper.pmid}
                </a>
              </>
            )}
            {!paper.doi && !paper.pmid && <span class="mono">{id}</span>}
          </span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .answer {
    margin: 1.5rem 0 0;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 2px solid var(--ink);
    padding: 1.25rem 1.4rem;
    max-height: 34rem;
    overflow: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .attribution {
    margin-top: 2.25rem;
    display: grid;
    gap: 0.6rem;
  }
  .attribution > .quiet {
    font-size: 0.98rem;
    max-width: var(--measure);
  }
  .terms {
    max-width: var(--measure);
    font-size: 0.95rem;
    border-left: 2px solid var(--hema);
    padding-left: 0.9rem;
    color: var(--ink-2);
  }
  .cites {
    margin: 0.5rem 0 0;
    padding-left: 1.6rem;
    display: grid;
    gap: 1rem;
    font-size: 0.95rem;
    max-width: 58rem;
  }
  .cites li::marker {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .cites li > span {
    display: block;
  }
  .title {
    font-weight: 600;
  }
  .terms-line,
  .source {
    font-size: 0.88rem;
  }
  .licence {
    font-weight: 600;
    color: var(--hema);
    white-space: nowrap;
  }
  .cites a {
    overflow-wrap: anywhere;
  }
  .pmid {
    white-space: nowrap;
  }
</style>
