---
/**
 * Clusters in the order the ranker produced. Both honesty qualifiers sit ABOVE the list: a
 * tidy order implies a validated one, and a label implies ground truth; neither is true.
 */
import { clusterDomId } from "../lib/dom";
import { parseAnchor, tiedWithPrevious, type FixtureCluster, type FixtureRun } from "../lib/fixtures";

interface Props {
  run: FixtureRun;
}

const { run } = Astro.props;
const clusters = [...run.clusters].sort((a, b) => a.rank - b.rank);

const anchored = new Map<string, string>();
for (const finding of run.findings) {
  const anchor = parseAnchor(finding.anchor);
  if (anchor.kind === "cluster") anchored.set(anchor.key, finding.defect_id);
}

function matchText(cluster: FixtureCluster): string {
  const sides = cluster.concept_names.length;
  if (cluster.matched === sides) return sides === 2 ? "Both concepts match the question." : "Every concept matches the question.";
  return cluster.matched === 1 ? "One concept matches the question." : `${cluster.matched} of ${sides} concepts match the question.`;
}

function proximityText(cluster: FixtureCluster): string {
  if (cluster.matched === cluster.concept_names.length) return "";
  if (cluster.proximity === null) return "The other shares no MeSH tree placement with any question concept.";
  return `The other is at MeSH tree distance ${cluster.proximity} from the nearest question concept.`;
}
---

<p class="caveat">
  <strong>The order is not validated.</strong> Clusters are ranked by how many of their concepts
  match the question, then by MeSH tree distance (ADR-0020, ADR-0022). No label evidence could
  score that ordering (ADR-0023), so a sensible-looking order here is a design argument, not a
  measured result.
</p>
<p class="caveat">
  <strong>Labels are annotation, not ground truth.</strong> They come from a frozen relevance pass
  whose control instrument was later found compromised (ADR-0021). They show what an annotator
  said about a cluster, not something the pipeline achieved.
</p>

<ol class="clusters">
  {
    clusters.map((cluster) => {
      const defect = anchored.get(cluster.key);
      const tie = tiedWithPrevious(run, cluster);
      return (
        <li class:list={["cluster", { anchored: defect }]} id={clusterDomId(cluster.key)}>
          <span class="rank num" aria-label={`Rank ${cluster.rank}`}>
            {cluster.rank}
          </span>
          <div class="body">
            <p class="names">
              {cluster.concept_names.map((name, index) => (
                <>
                  {index > 0 && <span class="with"> with </span>}
                  <span class="concept">{name}</span>
                </>
              ))}
            </p>
            <p class="facts">
              <span class="num">
                {cluster.paper_ids.length} {cluster.paper_ids.length === 1 ? "paper" : "papers"}.
              </span>{" "}
              {matchText(cluster)} {proximityText(cluster)}
            </p>
            {tie && (
              <p class="tie">
                Tied with the cluster above on both ranking signals, so their relative order is
                MeSH id order and says nothing about relevance.
              </p>
            )}
            <p class="meta">
              <span class="key mono">{cluster.key}</span>
              {cluster.label && <span class={`label label-${cluster.label}`}>Annotated {cluster.label.replace("_", " ")}</span>}
              {defect && (
                <a class="defect-link" href={`#finding-${defect}`}>
                  {defect}
                </a>
              )}
            </p>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .clusters {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .cluster {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 1.5rem;
  }
  .rank {
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--ink-3);
    line-height: 1.1;
    text-align: right;
  }
  .body {
    display: grid;
    gap: 0.3rem;
  }
  .names {
    font-size: 1.3rem;
    line-height: 1.3;
  }
  .with {
    color: var(--ink-3);
    font-style: italic;
    font-size: 1.05rem;
  }
  .facts {
    color: var(--ink-2);
    font-size: 0.98rem;
  }
  .tie {
    color: var(--hema);
    font-size: 0.92rem;
    max-width: var(--measure);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
    font-size: 0.85rem;
  }
  .key {
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .label {
    color: var(--ink-2);
    border: 1px dashed var(--rule-strong);
    border-radius: 3px;
    padding: 0 0.4rem;
  }
  .label-off_topic {
    color: var(--eosin);
    border-color: var(--eosin-2);
  }
  .anchored {
    background: var(--eosin-wash);
  }
  .defect-link {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--eosin);
    font-weight: 500;
  }
</style>
